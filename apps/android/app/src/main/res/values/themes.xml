<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No action bar: the screen draws its own header, and a second one above
         it would be a frame around a frame. Transparent system bars because the
         Compose content pads itself into the safe area. -->
    <style name="Theme.Flit" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
