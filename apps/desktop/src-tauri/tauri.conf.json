{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flit",
  "version": "0.1.0",
  "identifier": "dev.flit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flit",
        "width": 1040,
        "height": 760,
        "minWidth": 640,
        "minHeight": 520,
        "center": true,
        "decorations": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Flit contributors",
    "copyright": "Copyright 2026 Flit contributors",
    "license": "MIT OR Apache-2.0",
    "category": "Utility",
    "shortDescription": "Send files and text between devices on your network.",
    "longDescription": "Flit moves files, folders and short text between devices on the same local network. No account, no cloud, no relay: the two devices talk to each other, and every transfer is verified end to end.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}